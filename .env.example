# Laravel ERP base URL, no trailing slash. Never commit real values.
EXPO_PUBLIC_API_BASE_URL=https://dev.triz.co.in
EXPO_PUBLIC_APP_ENV=development
# From `eas init`; enables OTA updates
EAS_PROJECT_ID=
# Hosts the ERP menu may name in absolute endpoint URLs; they are re-based onto EXPO_PUBLIC_API_BASE_URL and any
# other host is blocked (the bearer token is never sent there). Comma separated. Empty = erp.triz.co.in,dev.triz.co.in
EXPO_PUBLIC_ERP_HOSTS=
# Local Laravel: use exactly http://127.0.0.1:8000 (the ERP's CSRF exemption is host-based; localhost:8000, 10.0.2.2
# and LAN IPs get HTTP 419 on most legacy endpoints). Android: `adb reverse tcp:8000 tcp:8000`.
